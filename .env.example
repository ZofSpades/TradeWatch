# Copy of the variables scripts/init-env.sh generates into .env (run `make env`).
# Values here are placeholders, not working secrets.

# Password of the tradewatch Postgres role.
POSTGRES_PASSWORD=change-me

# Signing secret of the API's access tokens (at least 32 bytes).
TW_API_JWT_SECRET=change-me-to-at-least-32-random-bytes

# Passwords of the API's two accounts, "analyst" and "admin" (at least 12 bytes).
TW_API_ANALYST_PASSWORD=change-me-analyst
TW_API_ADMIN_PASSWORD=change-me-admin

# Password of Grafana's admin account (dashboards are readable without it).
GRAFANA_ADMIN_PASSWORD=change-me-grafana
